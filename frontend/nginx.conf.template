# Production server for the Angular app (the official nginx image renders this template with
# envsubst at start, so PORT and BACKEND_INTERNAL_URL are read at runtime, not at build time).
# Only /api/ is proxied to the backend; every page route is served by the Angular SPA.

server {
    listen ${PORT};
    root /usr/share/nginx/html;
    server_tokens off;

    # Not in nginx's default MIME types; browsers want it to install the PWA.
    types {
        application/manifest+json webmanifest;
    }
    include /etc/nginx/mime.types;

    location ^~ /api/ {
        proxy_pass ${BACKEND_INTERNAL_URL};
        include /etc/nginx/miplante-proxy.conf;
    }

    # Redirect old .html links (printed QR codes, legacy callbacks) to clean SPA routes, keeping query strings.
    rewrite ^/(login|register|onboard|merchant|pay|cobro|sandbox)\.html$ /$1 permanent;

    # The service worker and its manifest must always be fresh, or a deploy never reaches phones.
    location ~ ^/(ngsw-worker\.js|ngsw\.json|safety-worker\.js|worker-basic\.min\.js|index\.html)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Hashed bundles never change.
    location ~* \.(?:js|css)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
