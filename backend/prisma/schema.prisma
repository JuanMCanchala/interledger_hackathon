// MiPlante persistence (ADR 0010). Money is integer minor units (BIGINT); the asset lives next to it.
// Open Payments amounts that can be in another currency (quotes) and secrets are kept as JSONB.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Merchant {
  id               String   @id @db.Uuid
  /// The account that registered the shop.
  ownerId          String?  @map("owner_id") @db.Uuid
  name             String
  wallet           String
  assetCode        String   @map("asset_code")
  assetScale       Int      @map("asset_scale")
  monthlyCap       BigInt   @map("monthly_cap")
  mandateId        String   @unique @map("mandate_id") @db.Uuid
  /// Optional monthly sales goal, in minor units.
  monthlySalesGoal BigInt?  @map("monthly_sales_goal")
  /// A new monthly cap waiting for approval, and the mandate that asks for it.
  pendingCap       BigInt?  @map("pending_cap")
  pendingMandateId String?  @map("pending_mandate_id") @db.Uuid
  createdAt        DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @map("updated_at") @db.Timestamptz(3)

  mandate Mandate  @relation(fields: [mandateId], references: [id])
  owner   User?    @relation(fields: [ownerId], references: [id])
  rules   Rule[]
  payouts Payout[]
  sales   Sale[]

  @@map("merchants")
}

/// Applied in `position` order, which is also their priority when the monthly cap runs out.
model Rule {
  merchantId   String  @map("merchant_id") @db.Uuid
  id           String  @db.Uuid
  position     Int
  label        String
  /// Groups the shop's wallets on screen (Proveedores, Microcréditos, Ahorro or the shop's own).
  category     String  @default("")
  kind         String
  destination  String
  shareBps     Int     @map("share_bps")
  /// Debt rules: what is due each calendar month.
  monthlyQuota BigInt? @map("monthly_quota")
  /// Debt rules only: what is still owed.
  outstanding  BigInt?
  repaid       BigInt  @default(0)
  /// Savings rules, optional: the amount the shop wants to reach.
  savingsGoal  BigInt? @map("savings_goal")
  /// Debt rules: day of the month (1-28) the creditor is paid.
  dueDay       Int?    @map("due_day")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@id([merchantId, id])
  @@unique([merchantId, position])
  @@map("rules")
}

model Sale {
  id               String    @id @db.Uuid
  merchantId       String    @map("merchant_id") @db.Uuid
  amount           BigInt
  assetCode        String    @map("asset_code")
  assetScale       Int       @map("asset_scale")
  description      String?
  status           String
  customer         String?
  paymentId        String?   @map("payment_id") @db.Uuid
  error            String?
  /// pending → running → done | skipped; moved to running atomically before any money moves.
  settlementStatus String    @map("settlement_status")
  settlementReason String?   @map("settlement_reason")
  keptAmount       BigInt?   @map("kept_amount")
  settledAt        DateTime? @map("settled_at") @db.Timestamptz(3)
  paidAt           DateTime? @map("paid_at") @db.Timestamptz(3)
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(3)

  merchant Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  payment  Payment?         @relation(fields: [paymentId], references: [id])
  items    SettlementItem[]

  @@index([merchantId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("sales")
}

/// One rule's share of a sale, in the sale's asset.
model SettlementItem {
  saleId      String  @map("sale_id") @db.Uuid
  position    Int
  ruleId      String  @map("rule_id") @db.Uuid
  label       String
  kind        String
  destination String
  amount      BigInt
  status      String
  capped      Boolean
  paymentId   String? @map("payment_id") @db.Uuid
  error       String?

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@id([saleId, position])
  @@map("settlement_items")
}

model Mandate {
  id           String   @id @db.Uuid
  status       String
  description  String?
  returnTo     String?  @map("return_to")
  sender       String
  maxAmount    Json     @map("max_amount")
  interval     String?
  error        String?
  createdAt    DateTime @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @map("updated_at") @db.Timestamptz(3)
  /// Secrets: never returned by the API.
  interaction  Json?
  token        Json?
  continuation Json?

  merchant Merchant?
  payments Payment[]

  @@map("mandates")
}

model Payment {
  id                 String    @id @db.Uuid
  kind               String
  status             String
  description        String?
  returnTo           String?   @map("return_to")
  /// Null for a payment request (the payer is not known).
  sender             String?
  receiver           String
  mandateId          String?   @map("mandate_id") @db.Uuid
  incomingPaymentUrl String    @map("incoming_payment_url")
  quoteId            String?   @map("quote_id")
  /// Kept verbatim as the wallet returned it.
  quoteExpiresAt     String?   @map("quote_expires_at")
  debitAmount        Json?     @map("debit_amount")
  receiveAmount      Json?     @map("receive_amount")
  receivedAmount     Json?     @map("received_amount")
  outgoingPaymentUrl String?   @map("outgoing_payment_url")
  authorizedAt       DateTime? @map("authorized_at") @db.Timestamptz(3)
  error              String?
  createdAt          DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @map("updated_at") @db.Timestamptz(3)
  /// Secrets: never returned by the API.
  interaction        Json?
  incomingToken      String?   @map("incoming_token")
  outgoingToken      String?   @map("outgoing_token")

  mandate         Mandate?         @relation(fields: [mandateId], references: [id])
  sales           Sale[]
  settlementItems SettlementItem[]

  @@index([mandateId, createdAt(sort: Desc)])
  @@map("payments")
}

/// A shopkeeper's account. The password is stored only as a salted scrypt hash.
model User {
  id           String   @id @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @map("created_at") @db.Timestamptz(3)

  merchants Merchant[]
  sessions  Session[]

  @@map("users")
}

/// A signed-in browser; the random token is sent as a Bearer token.
model Session {
  token     String   @id
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// One payment to a creditor: everything reserved for a debt rule, sent on its due day or early.
model Payout {
  id          String    @id @db.Uuid
  merchantId  String    @map("merchant_id") @db.Uuid
  ruleId      String    @map("rule_id") @db.Uuid
  label       String
  destination String
  amount      BigInt
  assetCode   String    @map("asset_code")
  assetScale  Int       @map("asset_scale")
  reason      String
  month       String
  status      String
  paymentId   String?   @map("payment_id") @db.Uuid
  error       String?
  /// Due-day payouts: the part taken from the shop\'s profit to complete the quota.
  topUp       BigInt?   @map("top_up")
  /// How a failed payout was resolved by the shopkeeper: "retried" or "marked-paid".
  resolution  String?
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt   DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @map("updated_at") @db.Timestamptz(3)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId, createdAt])
  @@map("payouts")
}
